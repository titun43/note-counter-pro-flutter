<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
    <!-- Theme for image_cropper (uCrop activity). image_cropper brings
         com.android.support:appcompat-v7 as a dependency, so the AppCompat
         theme family is available at build time. -->
    <style name="CropTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">#FF1A1A2E</item>
    </style>
</resources>
