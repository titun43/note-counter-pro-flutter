<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color matching pubspec: #1A1A2E -->
    <item android:drawable="@color/splash_bg"/>
    <!-- Logo: use inset to push it slightly above center, preventing nav bar cutoff -->
    <item
        android:left="100dp"
        android:right="100dp"
        android:top="120dp"
        android:bottom="180dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/app_logo"/>
    </item>
</layer-list>
